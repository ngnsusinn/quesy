@startuml
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 17
skinparam shadowing false
skinparam ArrowColor #365B76
skinparam defaultFontColor #172B3C
skinparam nodesep 24
skinparam ranksep 26
scale 2
skinparam usecaseBackgroundColor #EDF4F9
skinparam usecaseBorderColor #365B76
skinparam actorBorderColor #365B76
skinparam rectangleBackgroundColor #F7FAFC
skinparam rectangleBorderColor #365B76
skinparam nodesep 14
skinparam ranksep 37

left to right direction
actor "Giáo viên" as Teacher
rectangle "Quesy · Ma trận và tạo mã đề" {
  usecase "Lưu ma trận đặc tả\n<size:13>UC-MAT-01</size>" as U1
  usecase "Kiểm tra khả năng đáp ứng ma trận\n<size:13>UC-MAT-02</size>" as U2
  usecase "Sinh đề gốc theo ma trận\n<size:13>UC-EXAM-01</size>" as U3
  usecase "Thay câu trong đề gốc\n<size:13>UC-EXAM-02</size>" as U4
  usecase "Sinh mã đề hoán vị\n<size:13>UC-EXAM-03</size>" as U5
}
Teacher -- U1
Teacher -- U2
Teacher -- U3
Teacher -- U4
Teacher -- U5
U2 -[hidden]right- U1
U3 -[hidden]right- U2
U4 -[hidden]right- U3
U5 -[hidden]right- U4
@enduml
