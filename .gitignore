# ==============================================================================
# QUESY - Git Ignore Specification
# Comprehensive configuration for FastAPI, TeX/LaTeX, Playwright, SQLite & Web
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*.venv/

# ------------------------------------------------------------------------------
# 3. Node.js & Package Managers
# ------------------------------------------------------------------------------
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.eslintcache/

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Playwright / E2E
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
nosetests.xml
*.cover
*.py,cover
test-results/
playwright-report/
blob-report/
playwright/.cache/
tests/tmp_*/
tests/tmp_test_pipeline/

# ------------------------------------------------------------------------------
# 5. Local Databases & SQLite
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
storage/*.db
storage/*.db-journal
storage/*.sqlite
storage/*.sqlite3
storage/quesy.db

# ------------------------------------------------------------------------------
# 6. Storage, Caches & Generated Assets
# ------------------------------------------------------------------------------
storage/uploads/*
!storage/uploads/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/assets/*
!storage/assets/.gitkeep
storage/cache/
storage/composer_cache/
storage/tikz_cache/
storage/math_cache/
storage/test_evidence/
storage/test_*.py
storage/*.json
storage/loop_test_report.json

