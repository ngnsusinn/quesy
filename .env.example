# ==============================================================================
# QUESY v2.0 - CẤU HÌNH API AI SỐ HÓA ĐỀ THI TRỰC TUYẾN
# Chuẩn hóa Thông tư 32/2018/TT-BGDĐT & Quyết định 764/QĐ-BGDĐT 2025
# ==============================================================================

# Lựa chọn AI_PROVIDER: openai | gemini | anthropic | openrouter | custom
AI_PROVIDER=openai

# Nhập API Key tương ứng với nhà cung cấp bạn muốn dùng:
AI_API_KEY=sk-proj-your-api-key-here

# Tên mô hình AI (Model Name):
# - Với OpenAI:     gpt-4o, gpt-4o-mini
# - Với Gemini:     gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# - Với Anthropic:  claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - Với OpenRouter: google/gemini-2.0-flash-exp:free, openai/gpt-4o-mini
AI_MODEL=gpt-4o

# (Tùy chọn) Endpoint tùy chỉnh hoặc Proxy:
# AI_BASE_URL=https://api.openai.com/v1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cấu hình nhiệt độ và độ dài phản hồi
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=8192
