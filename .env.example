# ==============================================================================
# QUESY v2.0 - CẤU HÌNH API AI SỐ HÓA ĐỀ THI TRỰC TUYẾN
# Chuẩn hóa Thông tư 32/2018/TT-BGDĐT & Quyết định 764/QĐ-BGDĐT 2025
# ==============================================================================

# Lựa chọn AI_PROVIDER: custom | openai | gemini | anthropic | openrouter
# Mặc định kết nối cụm AI suy luận nội bộ armbian:8317:
AI_PROVIDER=custom
AI_BASE_URL=http://armbian:8317/v1
AI_API_KEY=123
AI_MODEL=gemini-3.8-flash-high

# Hoặc cấu hình nhà cung cấp AI ngoại vi:
# AI_PROVIDER=openai
# AI_API_KEY=sk-proj-your-api-key-here
# AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1

# Cấu hình nhiệt độ và độ dài phản hồi
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=8192
